root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
# Markdown uses two trailing spaces as a hard line break, so do not strip them.
trim_trailing_whitespace = false

[*.bat]
# Windows batch files must keep CRLF line endings.
end_of_line = crlf
indent_style = space
indent_size = 2

[*.{txt,cfg,ini}]
indent_style = space
indent_size = 4
